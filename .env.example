# Use the Edit Cloudflare Workers token template, with D1 Edit and Zone DNS Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=

# App secrets are set with SST; see readme.md. DOMAIN must be hosted on Cloudflare.
DOMAIN=
SOURCE_URL=
ROOT_REDIRECT=
ALLOWED_USERS=
SIZE_LIMIT=32000000
PROMETHEUS=false
